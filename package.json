{
  "name": "crossline",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "assets": "node tools/build-assets.js",
    "assets:characters": "node tools/build-characters.js --install",
    "assets:buy-thumbnails": "node tools/build-buy-thumbnails.js",
    "assets:fonts": "node tools/build-fonts.js",
    "test:polish": "node --test tests/polish.test.js && node tests/polish-browser.js",
    "test:characters": "node tests/characters.js",
    "test:browser": "node tests/browser.js",
    "test:buy": "node --test tests/buy.test.js tests/buy-network.test.js && node tests/buy-browser.js",
    "test:bots": "node --test tests/bots.test.js tests/bots-network.test.js && node tests/bots-browser.js",
    "test:performance": "node tests/performance-browser.js",
    "test:home": "node tests/homepage.js",
    "test:visual": "node tests/visuals.js",
    "test:first-person": "node tests/first-person.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.55.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.35.4",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
